{
  "schema": "velxio-chip/v1",
  "name": "Boiler Interface",
  "author": "Jirka",
  "license": "MIT",
  "description": "Boiler controller interface with ON/OFF input, 12V reference and 0-12V temperature input.",
  "pins": [
    "ON/OFF",
    "12V REF",
    "TEMP 0-12V",
    "GND"
  ],
  "attributes": [
    { "name": "ignition_delay_s", "label": "Cold Ignition Delay (s)", "type": "float", "default": 42, "min": 0, "max": 180, "step": 1 },
    { "name": "vent_delay_s", "label": "Cold Vent-Open Delay (s)", "type": "float", "default": 36, "min": 0, "max": 180, "step": 1 },
    { "name": "reignition_delay_s", "label": "Warm Reignition Delay (s)", "type": "float", "default": 27, "min": 0, "max": 180, "step": 1 },
    { "name": "reignition_vent_delay_s", "label": "Warm Vent-Open Delay (s)", "type": "float", "default": 22, "min": 0, "max": 180, "step": 1 },
    { "name": "cycle_period_s", "label": "Target Cycle Period (s)", "type": "float", "default": 71, "min": 10, "max": 600, "step": 1 },
    { "name": "sensor_tau_s", "label": "Sensor Time Constant (s)", "type": "float", "default": 20, "min": 1, "max": 300, "step": 1 },
    { "name": "hysteresis_k", "label": "Hysteresis Band (C)", "type": "float", "default": 2, "min": 0.1, "max": 20, "step": 0.1 },
    { "name": "min_temp", "label": "Setpoint Floor (C)", "type": "float", "default": 45, "min": 0, "max": 100, "step": 1 },
    { "name": "max_temp", "label": "Setpoint Ceiling (C)", "type": "float", "default": 80, "min": 0, "max": 150, "step": 1 },
    { "name": "max_voltage", "label": "TEMP_IN Full-Scale (V)", "type": "float", "default": 12, "min": 1, "max": 24, "step": 0.5 }
  ],
  "display": {
    "width": 64,
    "height": 64
  }
}